# DevAstroAI backend environment variables.
# Last updated 2026-09-27 (foundation step 2: config single door).
#
#   LOCAL DEV  copy this file to backend/.env and fill in.
#   STAGING    set in Railway dashboard -> backend-staging service.
#   PRODUCTION set in Railway dashboard -> backend service.
#
# NEVER commit a populated .env. See DEPLOYMENT.md for which values
# differ per environment.
#
# ─────────────────────────────────────────────────────────────────
# THIS FILE IS THE COMPLETE LIST.
#
# Every variable the backend reads is declared as a typed field in
# app/config.py, and nothing else in app/ is allowed to touch
# os.getenv — tests/test_config_single_door.py fails the build if it
# does. So if a variable is not in app/config.py, the backend does not
# read it, no matter what any older doc claims.
#
# Adding one: declare the field in app/config.py, then add it here.
# ─────────────────────────────────────────────────────────────────


# ═══ Runtime ══════════════════════════════════════════════════════
# One of: development | staging | production. Case-insensitive.
# Gates the /astrologer/workspace auth bypass (never honoured in
# production) and tags Sentry events.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Case-insensitive.
LOG_LEVEL=INFO


# ═══ Secrets ══════════════════════════════════════════════════════
# Everything in this block is a credential. Real values live ONLY in
# the Railway dashboard.

# Postgres. Railway auto-injects this when the add-on is attached.
# Staging and production MUST use separate Postgres add-ons — sharing
# one defeats the point of having separate environments.
# Optional: without it the stateless KP endpoints (chart, horary,
# muhurtha, panchang, match) still serve; auth-gated ones return 503.
DATABASE_URL=postgresql://postgres:password@localhost:5432/devastroai

# Anthropic. Without it the app boots and logs a warning; AI endpoints
# fail. Everything else works.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — used for AUTH ONLY. The application database is the
# Railway Postgres above, not Supabase.
# SUPABASE_URL alone is enough for modern projects: it yields both the
# expected `iss` claim and the JWKS endpoint for ES256/RS256 tokens.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Only needed for LEGACY HS256 tokens. Modern projects do not issue
# them; leave unset unless you know you need it.
SUPABASE_JWT_SECRET=
# Auto-derived as {SUPABASE_URL}/auth/v1 when left unset. Override only
# if your project is unusual.
SUPABASE_JWT_ISSUER=

# Shared secret for GET /version/full (operator diagnostics). While
# unset that endpoint returns 404, so its existence is not advertised.
ADMIN_DEBUG_TOKEN=


# ═══ CORS ═════════════════════════════════════════════════════════
# Both unset -> main.py falls back to its built-in default allow-list
# plus a regex matching this project's Vercel preview deployments, and
# logs a warning at startup. In production, set the explicit list.
#
# Comma-separated, highest priority:
CORS_ALLOWED_ORIGINS=
# Single regex, for wildcard preview URLs:
CORS_ALLOWED_ORIGIN_REGEX=


# ═══ Request limits / rate limiting ═══════════════════════════════
# Reject POSTs larger than this. Default 2 MB (2097152).
# Do NOT lower below ~1 MB: chart-session saves carry the full
# workspace blob plus AI Q&A history. At 256 KB (the old value) saves
# began failing with 413 and answers silently stopped persisting.
MAX_REQUEST_BODY_BYTES=2097152

# Accepts true/false, 1/0, yes/no, on/off. Anything unparseable fails
# at startup rather than quietly picking a side.
# (Historic foot-gun: this was once compared with != "1", so setting it
# to `true` DISABLED the limiter. A typed bool makes that impossible.)
RATE_LIMIT_ENABLED=true

# Cap on tracked rate-limit buckets before the oldest 25% are evicted.
RATE_LIMIT_MAX_KEYS=20000

# Trusted reverse-proxy hops in front of the app. The client IP is read
# this many entries from the RIGHT of X-Forwarded-For, which a client
# cannot forge. Railway appends exactly one entry, so 1 is correct
# there. Too low buckets distinct users together (false 429s); too high
# re-opens IP spoofing.
TRUSTED_PROXY_HOPS=1


# ═══ Observability — Sentry ═══════════════════════════════════════
# Unset disables error monitoring entirely (the local-dev default).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of transactions traced, 0.0-1.0.
SENTRY_TRACES_SAMPLE_RATE=0.1


# ═══ Database pool tuning ═════════════════════════════════════════
# 10 + 20 sized for the CRM home firing useMe + useClients +
# useChartSessions in parallel alongside /health and the portal.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ═══ Development escape hatches ═══════════════════════════════════
# Log answer-cache hit/miss diagnostics.
CACHE_DIAG=false

# Set false to skip auth on /astrologer/workspace for local smoke
# tests. IGNORED when ENVIRONMENT=production — the bypass cannot be
# turned on in prod even by setting this.
WORKSPACE_AUTH_REQUIRED=true


# ═══ Injected by Railway — do not set by hand ═════════════════════
# Declared in app/config.py so /health and /version have one typed
# source. Railway populates them on every deploy.
#   RAILWAY_GIT_COMMIT_SHA
#   RAILWAY_GIT_COMMIT_MESSAGE
#   RAILWAY_GIT_BRANCH
#   RAILWAY_DEPLOYMENT_DRAINING_SECONDS


# ═══ Removed ══════════════════════════════════════════════════════
# FRONTEND_URL — listed here until 2026-09-27 but never read by any
# code. Removed rather than left to mislead. The frontend's own origin
# is handled by the CORS settings above.
